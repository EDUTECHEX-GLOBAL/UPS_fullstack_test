
# =========================================================
# Root-level .gitignore - EDUTECHEX UPS Platform
# =========================================================

# Node modules
**/node_modules/

# Build outputs
**/build/
**/dist/

# Environment files - IMPORTANT
.env
.env.*
**/.env
**/.env.*
!.env.example

# Explicit project environment files
college-app/.env
college-app/src/.env
server/.env
ai-agent/.env

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
tmp/
temp/

# IDE / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Testing and coverage
coverage/
**/coverage/

# Package manager caches
.pnp
.pnp.js
.parcel-cache/

